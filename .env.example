# ==========================================
# DEEP ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in values.
# Everything here is optional — DEEP boots and degrades gracefully without it.
# ==========================================

# --- Remote access ---
# DEEP always trusts loopback (127.0.0.1). Every other client — LAN, Tailnet —
# must present this key as ?key=, an x-deep-key header, or a deep_key cookie.
# Leave it unset and DEEP mints a random key on first boot, stores it in
# data/.deep_api_key, and prints it in the startup log.
# DEEP_API_KEY="choose-a-long-random-secret"

# Set to false ONLY on a trusted, isolated network — it opens the whole API
# and WebSocket to any client that can reach the port.
# DEEP_REQUIRE_REMOTE_AUTH="true"

# --- Web Search (Brave) ---
# Get a free key at: https://search.brave.com/api
BRAVE_API_KEY="your_brave_api_key_here"

# --- Smart Home (Home Assistant) ---
# Long-Lived Access Token from your Home Assistant profile
HOME_ASSISTANT_TOKEN="your_ha_token_here"
HOME_ASSISTANT_URL="http://homeassistant.local:8123"

# --- LLM Overrides (Optional) ---
# OLLAMA_MODEL="llama3.2"
# OLLAMA_BASE_URL="http://localhost:11434"

# --- TTS Voice Override (Optional) ---
# EDGE_TTS_VOICE="en-GB-RyanNeural"

# --- Cybersecurity Threat Intel (Optional) ---
# All of these are free-tier. Without them, the corresponding lookups/feeds
# gracefully return empty results instead of erroring — see
# core/intel_feeds.py and domains/cybersec/osint_engine.py.

# AlienVault/LevelBlue OTX — threat intel pulses. Free account + API key at
# https://otx.alienvault.com/api . After signing up, subscribe to a few
# active pulse authors on the OTX site (e.g. AlienVault's own feed) —
# the "subscribed pulses" endpoint only returns pulses from who you follow.
# OTX_API_KEY="your_otx_api_key_here"

# abuse.ch — covers URLhaus + ThreatFox + MalwareBazaar with one key.
# Free account at https://auth.abuse.ch/
# ABUSECH_AUTH_KEY="your_abusech_auth_key_here"

# AbuseIPDB — IP reputation/abuse reports. Free tier (1000 checks/day) at
# https://www.abuseipdb.com/register
# ABUSEIPDB_API_KEY="your_abuseipdb_api_key_here"

# VirusTotal — file/URL/IP/domain reputation. Free tier (rate-limited) at
# https://www.virustotal.com/gui/join-us
# VIRUSTOTAL_API_KEY="your_virustotal_api_key_here"

# Shodan — internet-exposure lookups (open ports, banners, known vulns per
# IP). Free tier available at https://account.shodan.io/register
# SHODAN_API_KEY="your_shodan_api_key_here"
